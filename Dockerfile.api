FROM python:3.13-slim AS base

ENV VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    DEBIAN_FRONTEND=noninteractive


FROM base AS builder

ENV POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=1 \
    POETRY_VIRTUALENVS_CREATE=1 \
    POETRY_CACHE_DIR=/tmp/poetry_cache

RUN apt-get update && \
    apt-get install --no-install-recommends -y build-essential && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Poetry
RUN pip install poetry==1.6.1

# Install dependencies first so this layer stays cached across source
# changes, then install the project itself so its console scripts
# (garmin-livetrack-email-listener, garmin-livetrack-api) get written into
# the venv.
COPY pyproject.toml poetry.lock ./
RUN poetry install --no-root && rm -rf $POETRY_CACHE_DIR

COPY garmin_livetrack /app/garmin_livetrack
RUN poetry install && rm -rf $POETRY_CACHE_DIR


FROM base AS runtime

COPY --from=builder ${VIRTUAL_ENV} ${VIRTUAL_ENV}
COPY garmin_livetrack /app/garmin_livetrack

WORKDIR /app

# Chromium plus the OS libraries Playwright needs to run it. Requires a
# glibc-based image (hence python:3.13-slim, not alpine): Playwright's
# browser builds don't support musl libc.
RUN playwright install --with-deps chromium

EXPOSE 8000

ENTRYPOINT ["garmin-livetrack-api"]
