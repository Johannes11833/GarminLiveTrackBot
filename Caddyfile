# Shared routing, used by both site blocks below.
(routes) {
	encode gzip

	# API routes (same origin as the viewer, so no CORS needed)
	handle /push/* {
		reverse_proxy garmin-livetrack-api:8000
	}
	handle /trackings* {
		reverse_proxy garmin-livetrack-api:8000
	}
	handle /docs* {
		reverse_proxy garmin-livetrack-api:8000
	}
	handle /openapi.json {
		reverse_proxy garmin-livetrack-api:8000
	}

	# Flutter web viewer, built and served by its own container (Dockerfile.viewer)
	handle {
		reverse_proxy garmin-livetrack-viewer:80
	}
}

# Local testing: Caddy issues a locally-trusted cert for "localhost"
# automatically, so https://localhost works out of the box.
localhost {
	import routes
}

# Production via Cloudflare Tunnel: cloudflared terminates HTTPS at
# Cloudflare's edge and forwards plain HTTP here, so no ACME/cert needed.
:80 {
	import routes
}
